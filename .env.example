# Chatbot Widget - Environment Variables Example
# Copy this file to .env.local for local development

# Chatbot API Configuration
VITE_CHATBOT_API_URL=http://localhost:3177/api/v1
VITE_CHATBOT_PUBLIC_KEY=your_api_key_here

# Development Server
VITE_PORT=5173
VITE_HOST=localhost

# Note: All VITE_ prefixed variables are bundled into the client-side code
# Do not put sensitive secrets here - use server-side environment variables
